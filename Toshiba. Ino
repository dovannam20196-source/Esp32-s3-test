#include <WiFi.h>
#include <WebServer.h>
#include <Update.h>
#include <math.h>

const char* AP_SSID = "TuLanh_Toshiba_Test";
const char* AP_PASS = "88888888";

#define PIN_CB_XADA      32
#define PIN_CB_NGANMAT   33
#define PIN_CB_NGANDA    34
#define PIN_CB_MOITRUONG 35

#define PIN_RL_XADA      16
#define PIN_RL_BLOCK_PWR 17
#define PIN_RL_DEN       22

#define PIN_PWM_BLOCK    25
#define PIN_PWM_QUAT     21
#define PIN_HALL_QUAT    26
#define PIN_CONGTAC_CUA  27

#define PIN_NUT_SW1      18
#define PIN_LED4         19
#define PIN_LED3         23
#define PIN_LED2         5
#define PIN_LED1         4

const float R_PULLUP = 3600.0;
const int PWM_FREQ_BLOCK = 1000;
const int PWM_FREQ_FAN   = 25000;
const int PWM_RES        = 8;

float tXaDa = 0, tNganMat = 0, tNganDa = 0, tMoiTruong = 0;
int mucNhiet = 1;
int testFanPct = 0;
int testBlockPct = 0;
bool testXaDa = false;
bool cuaMo = false;

volatile unsigned long xungHall = 0;
int fanRPM = 0;
unsigned long lastHallCalc = 0;

WebServer server(80);

void IRAM_ATTR ngatHall() {
  xungHall++;
}

float docNhietDo(int pin, float r25, float beta) {
  long tongADC = 0;
  for (int i = 0; i < 20; i++) {
    tongADC += analogRead(pin);
    delayMicroseconds(200);
  }
  float adc = tongADC / 20.0;
  if (adc < 50 || adc > 4040) return -99.9;
  float rNTC = R_PULLUP * (adc / (4095.0 - adc));
  float steinhart = log(rNTC / r25) / beta + 1.0 / (25.0 + 273.15);
  return (1.0 / steinhart) - 273.15;
}

void capNhatLedBoPhim() {
  digitalWrite(PIN_LED1, mucNhiet == 1 ? HIGH : LOW);
  digitalWrite(PIN_LED2, mucNhiet == 2 ? HIGH : LOW);
  digitalWrite(PIN_LED3, mucNhiet == 3 ? HIGH : LOW);
  digitalWrite(PIN_LED4, mucNhiet == 4 ? HIGH : LOW);
}

