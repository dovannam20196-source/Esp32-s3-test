void setup() {
  Serial.begin(115200);

  pinMode(PIN_RL_XADA, OUTPUT);      digitalWrite(PIN_RL_XADA, HIGH);
  pinMode(PIN_RL_BLOCK_PWR, OUTPUT); digitalWrite(PIN_RL_BLOCK_PWR, HIGH);
  pinMode(PIN_RL_DEN, OUTPUT);       digitalWrite(PIN_RL_DEN, HIGH);

  pinMode(PIN_NUT_SW1, INPUT_PULLUP);
  pinMode(PIN_CONGTAC_CUA, INPUT_PULLUP);
  pinMode(PIN_LED1, OUTPUT); pinMode(PIN_LED2, OUTPUT);
  pinMode(PIN_LED3, OUTPUT); pinMode(PIN_LED4, OUTPUT);
  capNhatLedBoPhim();

  ledcAttach(PIN_PWM_BLOCK, PWM_FREQ_BLOCK, PWM_RES);
  ledcAttach(PIN_PWM_QUAT, PWM_FREQ_FAN, PWM_RES);

  pinMode(PIN_HALL_QUAT, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(PIN_HALL_QUAT), ngatHall, FALLING);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);

  server.on("/", []() { server.send_P(200, "text/html", INDEX_HTML); });
  server.on("/data", []() {
    String json = "{\"t1\":" + String(tXaDa,1) + ",\"t2\":" + String(tNganMat,1) +
                  ",\"t3\":" + String(tNganDa,1) + ",\"t4\":" + String(tMoiTruong,1) +
                  ",\"cua\":" + String(cuaMo ? 1 : 0) + ",\"muc\":" + String(mucNhiet) +
                  ",\"rpm\":" + String(fanRPM) + "}";
    server.send(200, "application/json", json);
  });
  server.on("/cmd", []() {
    if (server.hasArg("fan")) {
      testFanPct = server.arg("fan").toInt();
      ledcWrite(PIN_PWM_QUAT, map(testFanPct, 0, 100, 0, 255));
    }
    if (server.hasArg("block")) {
      testBlockPct = server.arg("block").toInt();
      digitalWrite(PIN_RL_BLOCK_PWR, testBlockPct > 0 ? LOW : HIGH);
      ledcWrite(PIN_PWM_BLOCK, map(testBlockPct, 0, 100, 0, 255));
    }
    if (server.hasArg("xada")) {
      testXaDa = (server.arg("xada").toInt() == 1);
      digitalWrite(PIN_RL_XADA, testXaDa ? LOW : HIGH);
    }
    if (server.hasArg("led")) {
      mucNhiet = (mucNhiet % 4) + 1;
      capNhatLedBoPhim();
    }
    server.send(200, "text/plain", "OK");
  });

  server.on("/update", HTTP_GET, []() {
    server.send(200, "text/html", "<form method='POST' action='/update' enctype='multipart/form-data'><input type='file' name='update'><input type='submit' value='Nap Ban Chinh Thuc'></form>");
  });
  server.on("/update", HTTP_POST, []() {
    server.send(200, "text/plain", (Update.hasError()) ? "LOI" : "THANH CONG! DANG KHOI DONG LAI...");
    ESP.restart();
  }, []() {
    HTTPUpload& upload = server.upload();
    if (upload.status == UPLOAD_FILE_START) Update.begin(UPDATE_SIZE_UNKNOWN);
    else if (upload.status == UPLOAD_FILE_WRITE) Update.write(upload.buf, upload.currentSize);
    else if (upload.status == UPLOAD_FILE_END) Update.end(true);
  });

  server.begin();
}

void loop() {
  server.handleClient();

  tXaDa      = docNhietDo(PIN_CB_XADA, 5000.0, 3950.0);
  tNganMat   = docNhietDo(PIN_CB_NGANMAT, 10000.0, 3950.0);
  tNganDa    = docNhietDo(PIN_CB_NGANDA, 2000.0, 3950.0);
  tMoiTruong = docNhietDo(PIN_CB_MOITRUONG, 2000.0, 3950.0);

  static unsigned long lastBtn = 0;
  if (digitalRead(PIN_NUT_SW1) == LOW && (millis() - lastBtn > 300)) {
    lastBtn = millis();
    mucNhiet = (mucNhiet % 4) + 1;
    capNhatLedBoPhim();
  }

  cuaMo = (digitalRead(PIN_CONGTAC_CUA) == HIGH);
  digitalWrite(PIN_RL_DEN, cuaMo ? LOW : HIGH);

  if (millis() - lastHallCalc >= 1000) {
    fanRPM = (xungHall * 60) / 2;
    xungHall = 0;
    lastHallCalc = millis();
  }
}
